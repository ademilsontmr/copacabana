# Assets com hash — cache longo (Nitro também gera regras em dist/_headers)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pré-renderizado e fallback SSR — cache na borda para reduzir invocações do Worker
/
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

/blog
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

/blog/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=86400, s-maxage=604800

/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=604800
